    <Compile Include="src/PlayerService.Api/**/*.cs" />
    <ProjectReference Include="src/PlayerService.Application/PlayerService.Application.csproj" />
    <ProjectReference Include="src/PlayerService.Infrastructure.Redis/PlayerService.Infrastructure.Redis.csproj" />
  </ItemGroup>
</Project>
