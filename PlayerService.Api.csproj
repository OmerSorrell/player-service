    <DefaultItemExcludes>$(DefaultItemExcludes);.dotnet/**;artifacts/**;tests/**;tools/**;src/**/obj/**;src/**/bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
